# Copy to .env and fill in. Passwords live in ./secrets (see init-secrets.sh).

# Public hostname; Moodle is served at https://$MOODLE_DOMAIN. Changing it
# after install needs admin/tool/replace.
MOODLE_DOMAIN=moodle.example.com

# Git tag from github.com/moodle/moodle. Change it, then
# `docker compose up -d --build` to upgrade (back up first).
MOODLE_VERSION=v5.2.3

# Used by the first install only.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_FULLNAME=Moodle
MOODLE_SITE_SHORTNAME=moodle
MOODLE_SUPPORT_EMAIL=

# Outgoing mail. Leave MOODLE_SMTP_HOSTS empty to configure it in the admin UI
# instead. The password goes in secrets/smtp_password.
MOODLE_SMTP_HOSTS=
MOODLE_SMTP_SECURE=tls
MOODLE_SMTP_USER=
MOODLE_NOREPLY_ADDRESS=

PHP_TIMEZONE=UTC
# Roughly half the VPS's RAM on a host that runs only this stack.
MYSQL_INNODB_BUFFER_POOL_SIZE=1G

# Where the host's Caddy reaches Moodle. Keep it on loopback.
MOODLE_HTTP_BIND=127.0.0.1:8080

# Backups (backup.sh).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
